# Copy to .env.local. Validated by src/env.ts; server-only unless NEXT_PUBLIC_.

# --- WordPress / WooCommerce (Spectrum's store) ---
# Origin of the WordPress site, no trailing slash. Server-only.
WOOCOMMERCE_URL=
# Browser-facing origin when it differs from WOOCOMMERCE_URL (local Docker only).
WOOCOMMERCE_PUBLIC_URL=
# true once the Spectrum commerce plugin publishes `extensions.tpc` on the Store API;
# false serves the offline snapshot in src/data/products.ts.
WOOCOMMERCE_CATALOG_ENABLED=false
# Ship the offline snapshot on purpose when a build cannot reach the store.
CATALOG_ALLOW_SNAPSHOT_BUILD=false
# Same value as the plugin's `tpc_storefront_webhook_secret` (16+ chars).
WOOCOMMERCE_WEBHOOK_SECRET=
# REST keys (WooCommerce -> Settings -> Advanced -> REST API, read/write).
# Used by order tracking, restock alerts and locations; not by the catalogue.
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WOOCOMMERCE_API_TIMEOUT_MS=5000
ORDER_TRACKING_ENABLED=false
WOOCOMMERCE_SHIPMENT_TRACKING=false

# --- NVM Headless Core bridge (accounts, cart sessions, checkout handoff) ---
# Must match the Bridge key on WooCommerce -> Headless Core (32+ chars).
NVM_BRIDGE_KEY=
# Seals the encrypted cart cookie. Falls back to NVM_BRIDGE_KEY. 32+ chars.
CART_SESSION_KEY=
# "on" once the bridge's member-cart and research-declaration routes are live.
STOREFRONT_CONTRACT=off

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
STOREFRONT_INDEXING_ENABLED=false
